[user]
	email = runepeter@fiken.no
	name = Runaldo Rupert Bjørnstad
# user.signingkey er per maskin (1Password på Mac-en, nøkkelfil på Linux), i ~/.gitconfig
[gpg]
	format = ssh
[commit]
	gpgsign = true

[alias]
	co = checkout
	cob = checkout -b
	coo = !git fetch && git checkout
	br = branch
	brd = branch -d
	brD = branch -D
	merged = branch --merged
	dmerged = "git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"
	st = status
	aa = add -A .
	cm = commit -m
	aacm = !git add -A . && git commit -m
	cp = cherry-pick
	up = update
	amend = commit --amend -m
	dev = !git checkout dev && git pull origin dev
	staging = !git checkout staging && git pull origin staging
	master = !git checkout master && git pull origin 
	po = push origin
	pod = push origin dev
	pos = push origin staging
	pom = push origin master
	poh = push origin HEAD
	pogm = !git push origin gh-pages && git checkout master && git pull origin master && git rebase gh-pages && git push origin master && git checkout gh-pages
	pomg = !git push origin master && git checkout gh-pages && git pull origin gh-pages && git rebase master && git push origin gh-pages && git checkout master
	plo = pull origin
	plod = pull origin dev
	plos = pull origin staging
	plom = pull origin master
	ploh = pull origin HEAD
	unstage = reset --soft HEAD^
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	f = "!git ls-files | grep -i"
	gr = grep -Ii
la = "!git config -l | grep alias | cut -c 7-"	
	tree = log --graph --decorate --pretty=oneline --abbrev-commit
[credential]
	helper = cache --timeout=3600
[core]
	autocrlf = input
	excludesFile = ~/workspace/runepeter/dotfiles/gitignore_global
	pager = delta
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3

# Absolutte stier: en relativ include løses mot ~/.gitconfig, som på donnie er en lenke hit
[includeIf "hasconfig:remote.*.url:https://github.com/runepeter/**"]
	path = ~/workspace/runepeter/dotfiles/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:runepeter/**"]
	path = ~/workspace/runepeter/dotfiles/.gitconfig-personal
[gpg "ssh"]
	allowedSignersFile = ~/workspace/runepeter/dotfiles/allowed_signers
